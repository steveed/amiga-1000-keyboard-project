	(text "Key matrix: rows PA2-PA7, columns PD6-PD0 / PC7-PC0. No diodes in the original design."
		(exclude_from_sim no)
		(at 30.48 15.24 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "2b36de3f-e17f-5939-8519-2e515d1b9233")
	)
	(text "Recreated from Commodore drawing 327063 rev B (keyboard assy, Amiga 1000).\nThe original single-sided PCB used wire links J1-J11; these only carried\ntraces over each other and are omitted here, except where noted below.\nOriginal J8 / J9 select the extra matrix positions used on international\nlayouts: (RET) INTL = PA5/PC2, L SHIFT INTL = PA6/PD6.\nOriginal J3/J4 link PA0/PA1 to KCLK/KDAT; J2 links 556 OUT2 to /RES;\nJ5 links 556 OUT1 to TRIG2/THR2; J1 and J6 link +5V and GND to the 6500/1."
		(exclude_from_sim no)
		(at 283.21 236.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3822f8ac-e41a-5622-ae7e-a36de7f4fc3a")
	)
	(text "Modifier keys (port B, active low)"
		(exclude_from_sim no)
		(at 142.24 140.97 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "4904a02a-1be8-5d13-b66b-2d17ff17aec1")
	)
	(text "3.000 MHz: not marked on the\ndrawing, read from the crystal\non an assembled board."
		(exclude_from_sim no)
		(at 30.48 218.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7102932e-0f78-5463-8798-3548843b8c6e")
	)
	(text "Power-on reset (556). Timer A: delay after power-up;\ntimer B inverts it to drive /RES of the 6500/1."
		(exclude_from_sim no)
		(at 187.96 175.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
